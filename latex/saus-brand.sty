%% 3. INSTITUTIONAL DATA (override any of these in your own preamble)
%%--------------------------------------------------------------------------
\newcommand{\saus@university}{The Shaikh Ayaz University, Shikarpur}
\newcommand{\saus@shortuniversity}{The Shaikh Ayaz University, Shikarpur}
\newcommand{\saus@motto}{Revival of Educational Glory of Shikarpur}
\newcommand{\saus@web}{saus.edu.pk}
\newcommand{\saus@address}{Main Road, Shikarpur, Sindh}
\newcommand{\saus@phone}{+92 726 512039}
\newcommand{\saus@department}{}
\newcommand{\saus@event}{}

\newcommand{\sausuniversity}[1]{\renewcommand{\saus@university}{#1}}
\newcommand{\sausshortuniversity}[1]{\renewcommand{\saus@shortuniversity}{#1}}
\newcommand{\sausmotto}[1]{\renewcommand{\saus@motto}{#1}}
\newcommand{\sausweb}[1]{\renewcommand{\saus@web}{#1}}
\newcommand{\sausaddress}[1]{\renewcommand{\saus@address}{#1}}
\newcommand{\sausphone}[1]{\renewcommand{\saus@phone}{#1}}
\newcommand{\sausdepartment}[1]{\renewcommand{\saus@department}{#1}}
\newcommand{\sausevent}[1]{\renewcommand{\saus@event}{#1}}

