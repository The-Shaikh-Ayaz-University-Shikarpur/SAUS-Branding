%%==========================================================================
%%  saus-brand.sty
%%  Shared brand layer for THE SHAIKH AYAZ UNIVERSITY, SHIKARPUR
%%  "Revival of Educational Glory of Shikarpur"
%%
%%  Colours, institutional details, typography, Sindhi/Urdu support and
%%  small helpers. Loaded by the Beamer theme (beamerthemeSAUS.sty) and the
%%  poster class (saus-poster.cls), so both stay identical by construction.
%%  It can also be loaded on its own in any LaTeX document.
%%
%%  Version 1.3 -- 2026-09-21
%%==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{saus-brand}[2026/09/21 v1.3 Shaikh Ayaz University Shikarpur brand]

\RequirePackage{etoolbox}
\RequirePackage{kvoptions}
\RequirePackage{iftex}
\RequirePackage{xcolor}
\RequirePackage{graphicx}

%%--------------------------------------------------------------------------
%% 1. OPTIONS
%%--------------------------------------------------------------------------
% Options use their own prefix and are then copied to the shared \saus@...
% names, so the theme and poster class can declare the same options too.
\SetupKeyvalOptions{family=sausbrand,prefix=sausbrand@}
% path (with trailing slash) where the branding assets live
\DeclareStringOption[assets/]{assets}
% use the brand typefaces (false leaves fonts to the document)
\DeclareBoolOption[true]{fonts}
% native = sindhi | urdu | both | none  (native-script university name)
\DeclareStringOption[sindhi]{native}
% math = fira | garamond  (Garamond-Math for text set in EB Garamond)
\DeclareStringOption[fira]{math}
\ProcessKeyvalOptions*

\let\saus@assets\sausbrand@assets
\let\saus@native\sausbrand@native
\@ifundefined{ifsaus@fonts}{\newif\ifsaus@fonts}{}
\ifsausbrand@fonts\saus@fontstrue\else\saus@fontsfalse\fi

%%--------------------------------------------------------------------------
%% 2. BRAND COLOURS
%%    Maroon and royal blue are sampled directly from the university crest;
%%    gold, mist and the neutrals are the supporting family built around them.
%%--------------------------------------------------------------------------
\definecolor{sausmaroon}{HTML}{6B2A4C}      % primary   - crest script & border
\definecolor{sausmaroondark}{HTML}{4A1C34}  % primary   - deep, for large fields
\definecolor{sausmaroonlight}{HTML}{8E4166} % primary   - tints and hovers
\definecolor{sausblue}{HTML}{1A1A91}        % secondary - crest ring band
\definecolor{sausbluedark}{HTML}{131368}    % secondary - deep, for text
\definecolor{sausgold}{HTML}{C39B3E}        % accent    - rules, highlights
\definecolor{sausmist}{HTML}{F4EDF1}        % surface   - crest field tint
\definecolor{sausink}{HTML}{231C21}         % body text
\definecolor{sausslate}{HTML}{6A626B}       % muted text
\definecolor{sausrule}{HTML}{D9C9D2}        % hairlines
\definecolor{sausgreen}{HTML}{2E6B4F}       % semantic  - positive
\definecolor{sausred}{HTML}{B3261E}         % semantic  - alert

\colorlet{SAUSprimary}{sausmaroon}
\colorlet{SAUSsecondary}{sausblue}
\colorlet{SAUSaccent}{sausgold}

