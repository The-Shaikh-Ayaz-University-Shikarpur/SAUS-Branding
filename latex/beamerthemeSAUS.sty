%%==========================================================================
%%  beamerthemeSAUS.sty
%%  Official Beamer theme for
%%  THE SHAIKH AYAZ UNIVERSITY, SHIKARPUR
%%  "Revival of Educational Glory of Shikarpur"
%%
%%  https://saus.edu.pk  |  Main Road, Shikarpur, Sindh  |  +92 726 512039
