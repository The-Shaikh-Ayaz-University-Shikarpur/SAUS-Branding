# Text files: LF everywhere, in the repository and in the working tree.
*.tex    text eol=lf
*.sty    text eol=lf
*.cls    text eol=lf
*.bib    text eol=lf
*.csv    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.txt    text eol=lf
.latexmkrc text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE  text eol=lf

# PowerShell is run by Windows PowerShell: keep CRLF.
*.ps1    text eol=crlf

# Everything generated or binary: never diffed or line-ending converted.
*.pdf    binary
*.png    binary
*.jpg    binary
*.ico    binary
*.otf    binary
*.ttf    binary
*.docx   binary
*.dotx   binary
*.pptx   binary
*.potx   binary
*.xlsx   binary
*.xltx   binary

# Show the repository as what it mostly is, and keep vendored files out of the
# language statistics.
*.cls    linguist-language=TeX
fonts/**         linguist-vendored
latex/assets/**  linguist-vendored
brand-source/**  linguist-documentation
