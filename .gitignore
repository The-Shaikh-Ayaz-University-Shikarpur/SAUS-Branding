*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.nav
*.snm
*.toc
*.lof
*.lot
*.vrb
*.synctex.gz
*.xdv
*.bbl
*.bcf
*.blg
*.run.xml
build/

# Office lock files left by an open document
~$*

