# The Office fonts are installed, not shipped: fonts/ is a local drop box.
# The LaTeX build's Sindhi/Urdu fonts live in latex/assets/fonts and are kept.
fonts/*
!fonts/README.md

# Real signatures: never commit one. See brand-source/README.md.
signature-trans.png
signature*.png
!latex/assets/signature-specimen.png

